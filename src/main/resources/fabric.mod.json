{
  "schemaVersion": 1,
  "id": "premiere",
  "version": "${version}",
  "name": "Premiere",
  "description": "In-world movie theater: staff paste a URL, players with the client mod see the film on a vanilla block wall, Simple Voice Chat carries positional audio. Fully vanilla clients connect normally and just see the wall.",
  "authors": [
    "ZephByte"
  ],
  "contact": {},
  "license": "GPL-3.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.zephbyte.premiere.Premiere"
    ],
    "client": [
      "dev.zephbyte.premiere.client.PremiereClient"
    ],
    "voicechat": [
      "dev.zephbyte.premiere.audio.PremiereVoicechatPlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "voicechat": "*",
    "luckperms": "*"
  }
}
